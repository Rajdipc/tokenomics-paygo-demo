# Copy to .env, fill in your project ID, then run `source .env` (or `source deploy/00_variables.sh`)
# in Cloud Shell before running `run_experiment.py` or deploying the agent.

# 1. Google Cloud project and Gemini endpoint (REQUIRED — replace with your own project ID)
export GOOGLE_CLOUD_PROJECT="your-project-id"
export GOOGLE_CLOUD_LOCATION="global"
export GOOGLE_GENAI_USE_VERTEXAI="True"

# 2. Experiment tag (becomes a low-cardinality Cloud Billing label value: lowercase, digits, '-', '_')
export TBOM_RUN_TAG="exp-2026-10-20"

# 3. Deployment settings for Cloud Run and Gemini Platform Agent Runtime (Agent Engine)
export DEPLOY_REGION="us-central1"
export CLOUD_RUN_SERVICE="cymbal-claims-tbom-agent"
export ARTIFACT_REPO="cymbal-claims-tbom"
export SERVICE_ACCOUNT_NAME="cymbal-claims-agent-sa"
export AGENT_RUNTIME_DISPLAY_NAME="cymbal-claims-tbom-agent"
