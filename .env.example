# Copy to .env, fill in, then run `source .env` in Cloud Shell before run_experiment.py.

export GOOGLE_CLOUD_PROJECT="your-project-id"
# Global endpoint (recommended for Standard PayGo).
export GOOGLE_CLOUD_LOCATION="global"

# Groups one experiment. Becomes a billing label value, so use lowercase letters,
# digits, '-' or '_' only.
export TBOM_RUN_TAG="exp-2026-10-20"
